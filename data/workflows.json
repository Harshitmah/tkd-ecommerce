[
  {
    "id": "tpl-vip-greeting",
    "name": "VIP Customer Greeting",
    "trigger_type": "ORDER_PLACED",
    "is_active": true,
    "nodes": [
      {
        "id": "node-trigger",
        "type": "trigger",
        "label": "When Order is Placed",
        "config": {
          "triggerType": "ORDER_PLACED"
        },
        "x": 200,
        "y": 50
      },
      {
        "id": "node-cond-vip",
        "type": "condition",
        "label": "Check Order Total >= ₹50",
        "config": {
          "conditionField": "total",
          "conditionOperator": "gte",
          "conditionValue": "50"
        },
        "x": 60,
        "y": 240
      },
      {
        "id": "node-act-email",
        "type": "action",
        "label": "Send VIP Greeting Email",
        "config": {
          "actionType": "email",
          "emailTo": "customer",
          "emailSubject": "Welcome to the VIP Club! ✨",
          "emailBody": "Hi {customer_name},\n\nThank you for your premium purchase of {order_total}! As a VIP member, enjoy an exclusive 15% discount code on your next visit: VIP15.\n\nWarm regards,\nTelkidukan Support"
        },
        "x": 190,
        "y": 420
      },
      {
        "id": "node-act-timeline",
        "type": "action",
        "label": "Log VIP Timeline Note",
        "config": {
          "actionType": "timeline",
          "timelineNote": "VIP high-value order flagged. Total purchase: {order_total}"
        },
        "x": 300,
        "y": 680
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "node-trigger",
        "target": "node-cond-vip"
      },
      {
        "id": "e2",
        "source": "node-cond-vip",
        "target": "node-act-email",
        "conditionBranch": "true"
      },
      {
        "id": "e3",
        "source": "node-act-email",
        "target": "node-act-timeline"
      }
    ],
    "run_count": 3,
