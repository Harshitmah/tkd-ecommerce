          "emailBody": "Hi {customer_name},\n\nWe received your Cash on Delivery order #{order_number} for {order_total}.\n\nTo help us dispatch your items faster, please click here to confirm your shipping address and contact details.\n\nThank you,\nTelkidukan team"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "node-trigger",
        "target": "node-cond-cod"
      },
      {
        "id": "e2",
        "source": "node-cond-cod",
        "target": "node-act-cod-email",
        "conditionBranch": "true"
      }
    ],
