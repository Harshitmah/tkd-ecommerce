  {
    "id": "tpl-negative-review",
    "name": "Negative Review Escaler",
    "trigger_type": "REVIEW_RECEIVED",
    "is_active": true,
    "nodes": [
      {
        "id": "node-trigger",
        "type": "trigger",
        "label": "When Review is Received",
        "config": {
          "triggerType": "REVIEW_RECEIVED"
        }
      },
      {
        "id": "node-cond-low-rating",
        "type": "condition",
        "label": "Check Rating <= 2 Stars",
        "config": {
          "conditionField": "rating",
          "conditionOperator": "lte",
          "conditionValue": "2"
        }
      },
      {
        "id": "node-act-admin-alert",
        "type": "action",
        "label": "Alert Admin via Email",
        "config": {
          "actionType": "email",
          "emailTo": "admin",
          "emailSubject": "🚨 Urgent: Low Rating Received",
          "emailBody": "Hello Administrator,\n\nA negative review was submitted by {customer_name}.\nProduct: {product_title}\nRating: {rating} / 5 stars\nReview text: \"{review_text}\"\n\nPlease reach out to resolve the customer's issues."
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "node-trigger",
        "target": "node-cond-low-rating"
      },
      {
        "id": "e2",
        "source": "node-cond-low-rating",
        "target": "node-act-admin-alert",
        "conditionBranch": "true"
      }
    ],
    "run_count": 0,
    "created_at": "2026-05-20T19:18:23.671Z",
    "updated_at": "2026-05-20T19:18:23.671Z"
